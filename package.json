{
  "name": "modern-league",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.scoring.json --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "test:deployment": "node tests/browser/deployment.cjs",
    "test:browser": "node tests/browser/results-import.cjs && node tests/browser/supabase-admin.cjs",
    "test:browser:secure": "node tests/browser/secure-import.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^7.0.2",
    "vite": "^7.2.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  }
}
